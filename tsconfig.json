{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.tsx",
    "apps/desktop/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts",
    "apps/desktop/test/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.vite",
    "**/out",
    "_reference",
    "apps/desktop/src/renderer",
    "packages/ui",
    "tests/e2e"
  ]
}
