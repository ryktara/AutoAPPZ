{
  "name": "autoappz",
  "version": "0.0.0",
  "private": true,
  "description": "AutoAPPZ — local-first, agentic software engineering environment",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/desktop/src/renderer/tsconfig.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @autoappz/e2e test",
    "clean-room:check": "node tools/check-clean-room.mjs",
    "dev": "pnpm --filter @autoappz/desktop dev",
    "build": "pnpm --filter @autoappz/desktop build",
    "package": "pnpm --filter @autoappz/desktop package",
    "changeset": "changeset",
    "test:security": "vitest run tests/security",
    "bench": "node --experimental-transform-types tools/bench/run.mjs --check",
    "bench:startup": "node tools/bench/startup.mjs",
    "license:notice": "node tools/license-notice.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
